+
 	if ((v = cbor_map_handle(item)) == NULL) {
 		fido_log_debug("%s: cbor_map_handle", __func__);
 		return (-1);
 	}
 
-	n = cbor_map_size(item);
-
 	for (size_t i = 0; i < n; i++) {
