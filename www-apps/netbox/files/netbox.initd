#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="NetBox WSGI service (gunicorn)"
command="/usr/bin/@EPYTHON@"
command_args="-m gunicorn --pythonpath /opt/netbox/netbox --config /etc/netbox/gunicorn.py netbox.wsgi"
command_user="netbox:netbox"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
directory="/opt/netbox/netbox"
output_log="/var/log/netbox/${RC_SVCNAME}.log"
error_log="/var/log/netbox/${RC_SVCNAME}.log"

depend() {
	need net
	use postgresql redis
	after postgresql redis
}
