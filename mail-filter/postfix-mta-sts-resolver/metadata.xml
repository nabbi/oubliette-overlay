<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
	<maintainer type="person">
		<email>nic@boet.cc</email>
	</maintainer>

	<longdescription>
		A socketmap daemon that gives Postfix the TLS policy of a destination
		domain from its MTA-STS (RFC 8461) policy, cached, for
		smtp_tls_policy_maps. It runs as the mta-sts user.
	</longdescription>

	<use>
		<flag name="redis">Cache policies in Redis (<pkg>dev-python/redis</pkg>)</flag>
		<flag name="sqlite">Cache policies in SQLite (<pkg>dev-python/aiosqlite</pkg>)</flag>
		<flag name="uvloop">Run the event loop on <pkg>dev-python/uvloop</pkg></flag>
	</use>

	<upstream>
		<remote-id type="github">Snawoot/postfix-mta-sts-resolver</remote-id>
		<remote-id type="pypi">postfix-mta-sts-resolver</remote-id>
		<bugs-to>https://github.com/Snawoot/postfix-mta-sts-resolver/issues</bugs-to>
	</upstream>
</pkgmetadata>
