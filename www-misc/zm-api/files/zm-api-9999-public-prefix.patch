diff --git a/packaging/man/zm-api.env.5 b/packaging/man/zm-api.env.5
index 641fdcc..219c6a4 100644
--- a/packaging/man/zm-api.env.5
+++ b/packaging/man/zm-api.env.5
@@ -199,6 +199,20 @@ seconds, not a request rate. Zero disables it; it is off by default.
 A tighter limiter on the authentication endpoints, on by default so credential
 brute-forcing is throttled even when the global limiter is off. Setting either
 to zero disables it.
+.TP
+.B APP_SERVER__PUBLIC_PREFIX
+Path a reverse proxy publishes zm-api under when it strips that path before
+passing requests on, for example
+.B /zm
+when
+.B /zm/api/v3/
+is mapped to
+.BR /api/v3/ .
+Routes do not change. Only URLs zm-api writes into responses get the prefix:
+HLS playlists, signed media links, the WHEP session
+.BR Location ,
+search results, and the document and request URLs of Swagger UI. Unset means
+the site root.
 .SH EXAMPLES
 A dashboard on its own hostname, API behind the same reverse proxy:
 .PP
@@ -210,6 +224,18 @@ APP_SERVER__MIDDLEWARE__TRUST_PROXY_HEADERS=true
 .EE
 .RE
 .PP
+The API published under
+.B /zm
+by the proxy, next to ZoneMinder's web interface:
+.PP
+.RS 4
+.EX
+APP_PROFILE=prod
+APP_SERVER__PUBLIC_PREFIX=/zm
+APP_SERVER__MIDDLEWARE__TRUST_PROXY_HEADERS=true
+.EE
+.RE
+.PP
 A remote database, overriding the
 .I zm.conf
 fallback:
diff --git a/packaging/systemd/zm-api.env b/packaging/systemd/zm-api.env
index 6ab0ce7..d076f55 100644
--- a/packaging/systemd/zm-api.env
+++ b/packaging/systemd/zm-api.env
@@ -20,6 +20,11 @@ RUST_LOG=info
 # does not apply.
 # APP_SERVER__ALLOWED_ORIGINS=https://zm.example.com
 
+# Behind a reverse proxy that publishes the API under a path and strips it
+# (/zm/api/v3 -> /api/v3), the links zm-api writes (HLS playlists, media
+# links, WHEP, search, Swagger UI) need that path in front.
+# APP_SERVER__PUBLIC_PREFIX=/zm
+
 # Serve the zm-web browser UI from this binary instead of running nginx in
 # front of both. The UI and the API then share an origin, so no CORS applies
 # and APP_SERVER__ALLOWED_ORIGINS above is not needed.
diff --git a/settings/base.toml b/settings/base.toml
index e9e1578..233fb91 100644
--- a/settings/base.toml
+++ b/settings/base.toml
@@ -16,6 +16,15 @@ port = 8080
 # Override per-host with: APP_SERVER__ALLOWED_ORIGINS=https://zm.example.com
 allowed_origins = []
 
+# Path a reverse proxy publishes zm-api under when it strips it before passing
+# requests on, e.g. "/zm" for /zm/api/v3 -> /api/v3. Routes do not change; only
+# URLs zm-api writes into responses get it: HLS playlists, media links, the
+# WHEP session Location, search results, Swagger UI's document and "try it out".
+# Empty means the site root.
+#
+# Override per-host with: APP_SERVER__PUBLIC_PREFIX=/zm
+public_prefix = ""
+
 # Serving the zm-web browser UI from this binary, instead of putting nginx in
 # front of both. One process, no CORS (the UI and the API share an origin by
 # construction), and TLS is already handled by [server.tls] / [server.acme].
diff --git a/src/configure/server.rs b/src/configure/server.rs
index 7e63d62..08909e9 100644
--- a/src/configure/server.rs
+++ b/src/configure/server.rs
@@ -1,5 +1,6 @@
 use std::net::{AddrParseError, SocketAddr};
 use std::path::PathBuf;
+use std::sync::OnceLock;
 
 use serde::Deserialize;
 
@@ -24,6 +25,40 @@ pub struct ServerConfig {
     /// HTTP middleware tuning (body limits, rate limiting).
     #[serde(default)]
     pub middleware: MiddlewareConfig,
+    /// Path the reverse proxy serves zm-api under, e.g. `/zm` when it maps
+    /// `/zm/api/v3/` to `/api/v3/` so the API sits with the rest of ZoneMinder.
+    /// Routes do not change; only URLs zm-api writes into responses get it:
+    /// stream and media links, the WHEP session `Location`, search results,
+    /// Swagger UI's document and the OpenAPI server. Empty (the default) means
+    /// the site root.
+    #[serde(default)]
+    pub public_prefix: String,
+}
+
+static PUBLIC_PREFIX: OnceLock<String> = OnceLock::new();
+
+/// Record `ServerConfig::public_prefix` once at startup.
+pub fn set_public_prefix(prefix: &str) {
+    let _ = PUBLIC_PREFIX.set(normalize_prefix(prefix));
+}
+
+/// The prefix in effect: empty, or `/`-led with no trailing `/`.
+pub fn public_prefix() -> &'static str {
+    PUBLIC_PREFIX.get().map(String::as_str).unwrap_or("")
+}
+
+/// `path`, as zm-api routes it, the way a client behind the proxy reaches it.
+pub fn public_path(path: &str) -> String {
+    format!("{}{path}", public_prefix())
+}
+
+fn normalize_prefix(prefix: &str) -> String {
+    let p = prefix.trim().trim_end_matches('/');
+    if p.is_empty() || p.starts_with('/') {
+        p.to_string()
+    } else {
+        format!("/{p}")
+    }
 }
 
 /// Accept either a comma-separated string or a sequence. TOML users write an
@@ -254,10 +289,20 @@ pub mod tests {
             acme: None,
             allowed_origins: Vec::new(),
             middleware: MiddlewareConfig::default(),
+            public_prefix: String::new(),
         };
         assert_eq!(config.get_http_addr(), "http://127.0.0.1:1024");
     }
 
+    #[test]
+    fn public_prefix_is_normalized() {
+        assert_eq!(normalize_prefix(""), "");
+        assert_eq!(normalize_prefix("/"), "");
+        assert_eq!(normalize_prefix("/zm"), "/zm");
+        assert_eq!(normalize_prefix("/zm/"), "/zm");
+        assert_eq!(normalize_prefix(" zm "), "/zm");
+    }
+
     #[test]
     pub fn middleware_config_defaults() {
         let mw = MiddlewareConfig::default();
