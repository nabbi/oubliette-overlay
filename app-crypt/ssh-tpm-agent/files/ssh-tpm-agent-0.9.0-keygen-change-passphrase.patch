From b49109f85f7b066a25841ed2752ab347c0933054 Mon Sep 17 00:00:00 2001
From: Enno Richter <2536303+elohmeier@users.noreply.github.com>
Date: Sun, 8 Nov 2026 07:06:54 +0100
Subject: [PATCH] ssh-tpm-keygen: fix passphrase change argument order

Pass the old passphrase before the new passphrase to ChangeAuth, matching the oldpin, newpin argument order in go-tpm-keyfiles.

The existing CLI test supplied -P and -N in reverse and masked the bug. Correct the flags and check that the old passphrase is rejected without modifying the key file, while the saved key accepts the new passphrase for a second change.

The corrected regression fails before the fix with TPM_RC_AUTH_FAIL and passes after it. Full go test ./... -count=1, go vet ./..., and Staticcheck v0.8.2 also pass.
---
 cmd/ssh-tpm-keygen/main.go                    |  2 +-
 cmd/ssh-tpm-keygen/testdata/script/keygen.txt | 14 ++++++++++++--
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/cmd/ssh-tpm-keygen/main.go b/cmd/ssh-tpm-keygen/main.go
index acf8c25..3a63da4 100644
--- a/cmd/ssh-tpm-keygen/main.go
+++ b/cmd/ssh-tpm-keygen/main.go
@@ -223,7 +223,7 @@ func doChangePin(tpm transport.TPMCloser, passphrase, keyPin, ownerPassword []by
 		fmt.Println()
 	}
 
-	if err := keyfile.ChangeAuth(tpm, ownerPassword, k.TPMKey, keyPin, passphrase); err != nil {
+	if err := keyfile.ChangeAuth(tpm, ownerPassword, k.TPMKey, passphrase, keyPin); err != nil {
 		log.Fatalf("Failed changing passphrase on the key: %v", err)
 	}
 
diff --git a/cmd/ssh-tpm-keygen/testdata/script/keygen.txt b/cmd/ssh-tpm-keygen/testdata/script/keygen.txt
index ee1cd74..9b4990c 100644
--- a/cmd/ssh-tpm-keygen/testdata/script/keygen.txt
+++ b/cmd/ssh-tpm-keygen/testdata/script/keygen.txt
@@ -32,9 +32,19 @@ rm .ssh
 
 # Change passphrase
 exec ssh-tpm-keygen -N 1234
-exec ssh-tpm-keygen -p -N 1234 -P 12345 -f .ssh/id_ecdsa.tpm
+exec ssh-tpm-keygen -p -P 1234 -N 12345 -f .ssh/id_ecdsa.tpm
 stdout 'new passphrase'
-rm .ssh
+
+# The old passphrase is rejected without changing the key file
+cp .ssh/id_ecdsa.tpm changed.tpm
+! exec ssh-tpm-keygen -p -P 1234 -N 67890 -f .ssh/id_ecdsa.tpm
+stderr 'Failed changing passphrase on the key'
+cmp .ssh/id_ecdsa.tpm changed.tpm
+
+# The saved key accepts the new passphrase for another change
+exec ssh-tpm-keygen -p -P 12345 -N 1234 -f .ssh/id_ecdsa.tpm
+stdout 'new passphrase'
+rm .ssh changed.tpm
 
 # Create ssh key and import as TSS keys
 exec ssh-keygen -t ecdsa -f id_ecdsa -N ''
